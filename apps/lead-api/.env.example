# CORS: Origins, von denen der Browser posten darf (Komma-getrennt, ohne Slash am Ende)
ALLOWED_ORIGINS=https://newedgebrand.com,https://www.newedgebrand.com,https://newedgebrand.netlify.app

# SMTP — Google Workspace: smtp.gmail.com + App-Passwort
# (Google-Konto → Sicherheit → 2FA → App-Passwörter → "Mail" anlegen)
#
# ACHTUNG: info@newedgebrand.com ist nur ein ALIAS von sebastian.p@newedgebrand.com.
# Ein Alias hat kein eigenes Google-Konto, also weder App-Passwörter noch eine
# eigene SMTP-Anmeldung. Angemeldet wird deshalb mit dem ECHTEN Konto (SMTP_USER),
# das App-Passwort entsteht in DESSEN Kontoeinstellungen. Als Absender (MAIL_FROM)
# darf der Alias stehen — Gmail erlaubt das für eigene Aliasse; falls Gmail den
# Absender trotzdem auf sebastian.p@ umschreibt, fehlt der Alias in Gmail unter
# Einstellungen → Konten → "Senden als".
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=sebastian.p@newedgebrand.com
SMTP_PASS=xxxx xxxx xxxx xxxx
MAIL_FROM=NEWEDGE <info@newedgebrand.com>

# Interne Lead-Benachrichtigung (leer lassen = aus)
NOTIFY_TO=santiago.p@newedgebrand.com

# "1" = Testmodus: PDF wird erzeugt + Lead gespeichert, aber keine Mail verschickt
SEND_DISABLED=0

# ── Leads zusätzlich im CMS sichtbar machen (optional) ──────────────────────
# Beide Variablen leer lassen = aus. Primärablage bleiben in jedem Fall
# data/leads.jsonl und data/contacts.jsonl; das CMS ist nur die Zweitablage,
# damit das Team die Leads ohne SSH im Strapi-Admin sieht.
# Ist das CMS nicht erreichbar, wird das nur geloggt — der Lead geht nie verloren.
#
# Token anlegen: Strapi-Admin → Einstellungen → API-Tokens → „Neuer API-Token"
#   Name: lead-api · Token-Typ: Custom · Gültigkeit: Unbegrenzt
#   Rechte: nur Lead → create (mehr braucht der Service nicht)
# Der Token wird genau EINMAL angezeigt — sofort hier eintragen.
#
# STRAPI_URL im gemeinsamen Stack (apps/cms/docker-compose.yml):
#   http://strapi:1337   ← Container-zu-Container, ohne nginx und ohne TLS.
# Im Standalone-Betrieb stattdessen die öffentliche Basis-URL, ohne /api und
# ohne Slash am Ende (z. B. https://newedgebrand.com).
# Ein depends_on entsteht dadurch NICHT: Ist Strapi weg, läuft der Call in den
# Timeout und wird geloggt — der Lead liegt zu dem Zeitpunkt längst in der Datei.
STRAPI_URL=
STRAPI_TOKEN=

# Timeout für den CMS-Call in Sekunden (optional, Default 5)
STRAPI_TIMEOUT=5

# ── Follow-ups (zeitversetztes Nachfassen) ─────────────────────────────────
# Default AUS. Solange FOLLOWUP_ENABLED=0 ist, wird nichts eingeplant und
# nichts verschickt — der Service verhält sich exakt wie vorher.
# Details und Betriebsanleitung: README-DEPLOY.md, Abschnitt „Follow-ups".
FOLLOWUP_ENABLED=0

# Kontaktformular-Follow-up: EIGENER Schalter, ebenfalls Default aus.
# Ehrliche Einschränkung: Der Service sieht nur den Eingang der Anfrage,
# nicht das Postfach. Er kann NICHT wissen, ob jemand aus dem Team längst
# geantwortet hat — eingeschaltet bekommt also auch jemand eine Erinnerung,
# der schon eine Antwort hat. Der Mailtext ist deshalb so formuliert, dass
# er in beiden Fällen passt („wenn erledigt, bitte ignorieren").
FOLLOWUP_CONTACT_ENABLED=0

# Abstände in Tagen (Kommazahlen erlaubt, z. B. 0.01 für Tests)
FOLLOWUP_ROI_DELAY_DAYS=3
FOLLOWUP_CONTACT_DELAY_DAYS=5

# Wie oft die Warteschlange geprüft wird (Minuten)
FOLLOWUP_INTERVAL_MINUTES=10

# Versendet der Service selbst? 1 = ja (Default, Hintergrund-Thread).
# 0 = es wird weiterhin eingeplant, aber nichts verschickt — für den Fall,
# dass die Warteschlange von außen per Cron abgearbeitet wird
# (`followups.py run-once --send`), und als Pause-Knopf: mit 0 bleibt alles
# liegen, während SEND_DISABLED=1 fällige Follow-ups als „dry_run" verbrennt.
FOLLOWUP_WORKER=1

# Versandfenster in lokaler Zeit — verhindert Mails um 4 Uhr nachts.
# "off" schaltet das Fenster ab. Außerhalb wird nur gewartet, nichts verworfen.
FOLLOWUP_SEND_WINDOW=08:00-18:00
FOLLOWUP_TZ=Europe/Berlin
FOLLOWUP_WEEKDAYS_ONLY=1

# Schutz nach längerem Ausfall: Einträge, die mehr als X Tage überfällig sind,
# werden verworfen statt verspätet zugestellt.
FOLLOWUP_MAX_OVERDUE_DAYS=14

# Wiederholversuche bei SMTP-Fehlern (nicht nach einem Absturz — siehe README)
FOLLOWUP_MAX_ATTEMPTS=3
FOLLOWUP_RETRY_MINUTES=30

# Abmeldelink (DSGVO). Öffentliche Basis-URL dieses Service, ohne Slash am
# Ende. Leer = im Mailtext steht nur die Abmeldung per Antwort/Mail.
FOLLOWUP_UNSUBSCRIBE_BASE=https://newedgebrand.com
FOLLOWUP_UNSUBSCRIBE_MAILTO=info@newedgebrand.com

# "1" = Follow-ups werden gerendert und protokolliert, aber nicht verschickt.
# SEND_DISABLED=1 erzwingt das ohnehin.
FOLLOWUP_DRY_RUN=0
