# NEWEDGE CMS — Produktions-Env (Vorlage)
# Auf dem Server nach .env kopieren und ALLE Secrets ersetzen:
#   cp .env.production.example .env
# Secrets erzeugen (je Aufruf ein Wert):
#   openssl rand -base64 32
# Für APP_KEYS vier Werte kommagetrennt eintragen.

HOST=0.0.0.0
PORT=1337

# ── Secrets (alle ersetzen!) ──────────────────────────────────────────────────
APP_KEYS="key1,key2,key3,key4"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# ── Öffentliche URL / Proxy ───────────────────────────────────────────────────
# Basis-URL, unter der Strapi von außen erreichbar ist. Im empfohlenen
# Same-Origin-Setup = die Website-Domain (nginx proxied /api, /admin, /uploads).
PUBLIC_URL=https://www.newedgebrand.com
IS_PROXIED=true

# ── Datenbank (Postgres via docker-compose) ───────────────────────────────────
# DATABASE_CLIENT/HOST/PORT setzt docker-compose.yml; hier nur Zugangsdaten.
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=tobemodified

# ── CORS ─────────────────────────────────────────────────────────────────────
# Nur relevant bei direktem Cross-Origin-Zugriff (z. B. cms.-Subdomain-Setup).
# Im Same-Origin-Setup greift CORS nicht; Liste trotzdem eng halten.
CORS_ORIGINS=https://www.newedgebrand.com,https://newedgebrand.com
